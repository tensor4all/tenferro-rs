{
  "default_branch": "main",
  "allow_auto_merge": true,
  "delete_branch_on_merge": true,
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "rustfmt",
      "cargo test (workspace)",
      "cargo test (prims inject)",
      "cargo test (linalg inject)",
      "coverage",
      "docs-site"
    ]
  }
}
