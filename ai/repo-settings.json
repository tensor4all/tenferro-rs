{
  "default_branch": "main",
  "allow_auto_merge": true,
  "delete_branch_on_merge": true,
  "fork_pr_contributor_approval": "all_external_contributors",
  "required_status_checks": {
    "strict": false,
    "contexts": [
      "rustfmt",
      "cargo test (blas inject)",
      "coverage",
      "docs-site",
      "CI gate (PR workspace tests)",
      "CI GPU gate",
      "repository rules review gate",
      "macOS workspace tests"
    ]
  },
  "pages": {
    "enabled": true,
    "build_type": "workflow"
  }
}
