external/

# Plan files
plan
docs/superpowers/plans/

# .env
.env
*.gif
*.png
/.superpowers/

# pi session artifacts (local only)
.pi-meetings/
.pi-subagents/

# LLVM profile data left by instrumented test runs
*.profraw
# Root-level markdown policy: keep only canonical project files here.
# Design notes, worklogs and implementation plans belong under docs/.
/*.md
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/AGENTS.md
!/CLAUDE.md
!/REPOSITORY_RULES.md
!/SUPPORT.md
!/CONTRIBUTORS.md
!/GOVERNANCE.md
!/IMPLEMENTATION-PLAN.md
!/PERFORMANCE_TIPS.md

# Creusot proof output and proof-script cache (`cargo creusot`)
verif/
.why3find/
why3find.proofs
