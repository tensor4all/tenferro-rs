# ============================================
# Rust
# ============================================

# Cargo build artifacts
debug/
target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# Mutation testing
**/mutants.out*/

# Coverage artifacts
coverage.json
coverage/
lcov.info
tarpaulin-report.html

# ============================================
# Python
# ============================================

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
wheels/

# Installer logs
pip-log.txt

